{
  "name": "md-cut",
  "private": true,
  "version": "0.1.0",
  "description": "Basic CapCut-like video editor (cut, text, audio, image overlay)",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron:build": "electron-builder",
    "electron:build:portable": "node scripts/build-portable.cjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "fluent-ffmpeg": "^2.1.3",
    "@types/fluent-ffmpeg": "^2.1.27",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.mdcut.app",
    "productName": "MD-Cut",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron",
      "node_modules/ffmpeg-static/**"
    ],
    "extraFiles": [
      { "from": "fonts", "to": "fonts" }
    ],
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true,
    "ffmpeg-static@5.3.0": true
  }
}
